# Unpress single-site — copy to .env (install.sh generates one for you)
# Frappe site name (also the local hostname)
UNPRESS_SITE=unpress.localhost
# Administrator password (required — install.sh generates a random one)
UNPRESS_ADMIN_PASSWORD=
# MariaDB root password
UNPRESS_DB_ROOT_PASSWORD=unpress
# Host port for HTTP
UNPRESS_HTTP_PORT=8080
# Engine image
UNPRESS_IMAGE=ghcr.io/neoserviceai/unpress:latest
# Public domain for TLS (then: docker compose --profile tls up -d)
# UNPRESS_DOMAIN=studio.example.com
